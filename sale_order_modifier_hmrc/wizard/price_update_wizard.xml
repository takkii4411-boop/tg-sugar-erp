<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_price_update_whatsapp_wizard" model="ir.ui.view">
        <field name="name">price.update.whatsapp.wizard.form</field>
        <field name="model">price.update.whatsapp.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp">
                <group>
                    <!-- Customers: backend me rahenge, UI me nahi dikhenge -->
                    <field name="partner_ids" invisible="1"/>

                    <!-- Sirf message body -->
                    <field name="notes" placeholder="Type your WhatsApp message here..." required="1"/>
                </group>

                <footer>
                    <button name="action_send_whatsapp"
                            type="object"
                            string="Send WhatsApp"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
