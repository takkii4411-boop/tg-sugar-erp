<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_menu_broker" name="Portal layout: Broker menu entries" inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <t t-if="page_name == 'broker_allotment' or (allotment and 'allotment.id' in allotment._fields)">
                <li class="breadcrumb-item active">My Broker Allotments</li>
            </t>
        </xpath>
    </template>

    <template id="portal_my_home_broker_allotment" name="Portal My Home: Broker Allotments" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_my_home')]" position="inside">
            <div class="o_portal_my_home_grid row g-2 mt-1">
                <div class="o_portal_index_card col-lg-6">
                    <a href="/my/broker-allotments" title="Broker Allotments" class="d-block text-decoration-none text-reset">
                        <div class="card h-100 shadow-sm border-0 bg-transparent">
                            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                                <div class="o_portal_index_card-icon mb-3">
                                    <i class="fa fa-file-text-o fa-2x text-primary"/>
                                </div>
                                <div class="h4 mb-0 text-center">Broker Allotments</div>
                                <small class="text-muted">
                                    <t t-if="broker_allotment_count" t-out="broker_allotment_count"/> allotment(s)
                                </small>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </xpath>
    </template>

    <template id="portal_my_broker_allotments" name="My Broker Allotments">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar">
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">My Broker Allotments</t>
                </t>
            </t>
            <t t-call="portal.portal_table">
                <t t-if="not allotments">
                    <p class="alert alert-warning">There are currently no broker allotments for your account.</p>
                </t>
                <t t-if="allotments">
                    <thead>
                        <tr class="active">
                            <th>Reference</th>
                            <th>Tender</th>
                            <th class="text-end">Total Qty</th>
                            <th class="text-end">Balance Qty</th>
                            <th class="text-end">Total Amount</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="allotments" t-as="allotment">
                            <tr>
                                <td>
                                    <span t-field="allotment.name"/>
                                </td>
                                <td>
                                    <span t-field="allotment.tender_id.name" t-if="allotment.tender_id"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="allotment.total_qty"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="allotment.bal_qty"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="allotment.amount_total" t-options="{'widget': 'monetary', 'display_currency': allotment.currency_id}"/>
                                </td>
                                <td>
                                    <t t-if="allotment.state == 'draft'">
                                        <span class="badge bg-secondary">Draft</span>
                                    </t>
                                    <t t-if="allotment.state == 'confirm'">
                                        <span class="badge bg-success">Confirmed</span>
                                    </t>
                                    <t t-if="allotment.state == 'cancel'">
                                        <span class="badge bg-danger">Cancelled</span>
                                    </t>
                                </td>
                                <td class="text-end">
                                    <a t-attf-href="/my/broker-allotment/{{ allotment.id }}" class="btn btn-primary btn-sm">View</a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
        </t>
    </template>

    <template id="portal_broker_allotment_detail" name="Broker Allotment Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar">
                <ol class="breadcrumb o_portal_submenu">
                    <li class="breadcrumb-item">
                        <a href="/my/broker-allotments">My Broker Allotments</a>
                    </li>
                    <li class="breadcrumb-item active">
                        <span t-field="allotment.name"/>
                    </li>
                </ol>
            </t>
            <div class="container mt-3">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-6">
                                <h4>Broker Allotment: <span t-field="allotment.name"/></h4>
                            </div>
                            <div class="col-6 text-end">
                                <t t-if="allotment.state == 'draft'">
                                    <span class="badge bg-secondary">Draft</span>
                                </t>
                                <t t-if="allotment.state == 'confirm'">
                                    <span class="badge bg-success">Confirmed</span>
                                </t>
                                <t t-if="allotment.state == 'cancel'">
                                    <span class="badge bg-danger">Cancelled</span>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Order Date:</strong>
                                <span t-field="allotment.date_order"/><br/>
                                <strong>Customer/Broker:</strong>
                                <span t-field="allotment.partner_id.name"/><br/>
                                <t t-if="allotment.tender_id">
                                    <strong>Tender:</strong>
                                    <span t-field="allotment.tender_id.name"/><br/>
                                </t>
                            </div>
                            <div class="col-6">
                                <t t-if="allotment.pay">
                                    <strong>Pay Date:</strong>
                                    <span t-field="allotment.pay"/><br/>
                                </t>
                                <t t-if="allotment.lift">
                                    <strong>Lift Date:</strong>
                                    <span t-field="allotment.lift"/><br/>
                                </t>
                            </div>
                        </div>
                        <t t-if="allotment.order_line">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Balance Qty</th>
                                        <th class="text-end">Unit Price</th>
                                        <th class="text-end">Taxes</th>
                                        <th class="text-end">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="allotment.order_line" t-as="line">
                                        <tr>
                                            <td>
                                                <span t-field="line.product_id.name"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.product_uom_qty"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.balance_qty"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': allotment.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.price_tax" t-options="{'widget': 'monetary', 'display_currency': allotment.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.price_total" t-options="{'widget': 'monetary', 'display_currency': allotment.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="5" class="text-end">
                                            <strong>Untaxed Amount:</strong>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="allotment.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': allotment.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="5" class="text-end">
                                            <strong>Taxes:</strong>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="allotment.amount_tax" t-options="{'widget': 'monetary', 'display_currency': allotment.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="5" class="text-end">
                                            <strong>Total:</strong>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="allotment.amount_total" t-options="{'widget': 'monetary', 'display_currency': allotment.currency_id}"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                        <t t-if="allotment.note">
                            <div class="mt-3">
                                <strong>Terms and Conditions:</strong><br/>
                                <div t-field="allotment.note"/>
                            </div>
                        </t>
                    </div>
                    <!-- Party Order Creation Section -->
                    <div class="card-footer">
                        <div class="row">
                            <div class="col-6">
                                <t t-if="allotment.bal_qty > 0">
                                    <a t-attf-href="/my/broker-allotment/{{ allotment.id }}/create-party-order" class="btn btn-primary">
                                        <i class="fa fa-plus-circle me-2"/>Create Party Order
                                    </a>
                                </t>
                                <t t-else="">
                                    <button class="btn btn-secondary" disabled="1">
                                        <i class="fa fa-ban me-2"/>No Balance Available
                                    </button>
                                </t>
                            </div>
                            <div class="col-6 text-end">
                                <span class="text-muted">Balance Qty: <strong t-field="allotment.bal_qty"/></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Party Order Creation Form -->
    <template id="portal_create_party_order" name="Create Party Order">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar">
                <ol class="breadcrumb o_portal_submenu">
                    <li class="breadcrumb-item">
                        <a href="/my/broker-allotments">My Broker Allotments</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a t-attf-href="/my/broker-allotment/{{ allotment.id }}"><span t-field="allotment.name"/></a>
                    </li>
                    <li class="breadcrumb-item active">Create Party Order</li>
                </ol>
            </t>
            <div class="container mt-3">
                <div class="row">
                    <div class="col-lg-12">
                        <h3>Create Party Order</h3>
                        <p class="text-muted">Create a new Party Order from Broker Allotment <strong t-field="allotment.name"/></p>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Party Order Details</h5>
                    </div>
                    <div class="card-body">
                        <form t-attf-action="/my/broker-allotment/{{ allotment.id }}/create-party-order/submit" method="post" class="row">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <!-- Error Messages -->
                            <t t-if="error">
                                <div class="col-12 mb-3">
                                    <div class="alert alert-danger">
                                        <t t-if="error == 'missing_party'">Please select a Party.</t>
                                        <t t-if="error == 'invalid_party'">Invalid Party selected.</t>
                                        <t t-if="error == 'qty_exceeded'">Quantity exceeds available balance.</t>
                                        <t t-if="error == 'invalid_price'">Please enter a valid selling price greater than 0.</t>
                                        <t t-if="error == 'no_lines'">Please select at least one product with quantity greater than 0.</t>
                                        <t t-if="error == 'creation_failed'">Failed to create Party Order. Please try again.</t>
                                        <t t-if="error == 'no_balance'">No balance quantity available for this allotment.</t>
                                    </div>
                                </div>
                            </t>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Party Name <span class="text-danger">*</span></label>
                                <select name="party_id" class="form-select" required="1">
                                    <option value="">Select Party...</option>
                                    <t t-foreach="parties" t-as="party">
                                        <option t-att-value="party.id"><t t-esc="party.name"/></option>
                                    </t>
                                </select>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label class="form-label">Pay Date</label>
                                <input type="date" name="pay_date" class="form-control"/>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label class="form-label">Lift Date</label>
                                <input type="date" name="lift_date" class="form-control"/>
                            </div>

                            <div class="col-12 mb-3">
                                <label class="form-label">Select Products <span class="text-danger">*</span></label>
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th width="40">
                                                    <input type="checkbox" id="select_all" class="form-check-input"/>
                                                </th>
                                                <th>Product</th>
                                                <th class="text-end">Available Qty</th>
                                                <th class="text-end">Unit Price (Brk)</th>
                                                <th class="text-end">Party Qty</th>
                                                <th class="text-end">Selling Price</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="allotment.order_line.filtered(lambda l: l.balance_qty > 0)" t-as="line">
                                                <tr>
                                                    <td>
                                                        <input type="checkbox" t-att-name="'line_selected_%d' % line.id" class="form-check-input line-checkbox" t-att-value="line.id"/>
                                                    </td>
                                                    <td>
                                                        <span t-field="line.product_id.name"/>
                                                        <input type="hidden" t-att-name="'line_product_%d' % line.id" t-att-value="line.product_id.id"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-field="line.balance_qty"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-field="line.price_unit"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <input type="number" t-att-name="'line_qty_%d' % line.id" class="form-control form-control-sm d-inline-block text-end" style="width: 100px;" min="0" t-att-max="line.balance_qty" step="0.01" value="0"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <input type="number" t-att-name="'line_price_%d' % line.id" class="form-control form-control-sm d-inline-block text-end" style="width: 100px;" min="0" step="0.01" t-att-value="line.price_unit"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-primary me-2">Create Party Order</button>
                                <a t-attf-href="/my/broker-allotment/{{ allotment.id }}" class="btn btn-secondary">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <script>
                document.getElementById('select_all').addEventListener('change', function() {
                    var checkboxes = document.querySelectorAll('.line-checkbox');
                    checkboxes.forEach(function(cb) {
                        cb.checked = this.checked;
                    }.bind(this));
                });
            </script>
        </t>
    </template>

    <!-- Party Order Detail View -->
    <template id="portal_party_order_detail" name="Party Order Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar">
                <ol class="breadcrumb o_portal_submenu">
                    <li class="breadcrumb-item">
                        <a href="/my/broker-allotments">My Broker Allotments</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a t-attf-href="/my/broker-allotment/{{ order.broker_allotment_id.id }}"><span t-field="order.broker_allotment_id.name"/></a>
                    </li>
                    <li class="breadcrumb-item active">Party Order <span t-field="order.name"/></li>
                </ol>
            </t>
            <div class="container mt-3">
                <div class="alert alert-success">
                    <i class="fa fa-check-circle me-2"/>Party Order created successfully!
                </div>

                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-6">
                                <h4>Party Order: <span t-field="order.name"/></h4>
                            </div>
                            <div class="col-6 text-end">
                                <span t-if="order.state == 'draft'" class="badge bg-secondary">Draft</span>
                                <span t-if="order.state == 'sent'" class="badge bg-info">Sent</span>
                                <span t-if="order.state == 'sale'" class="badge bg-success">Confirmed</span>
                                <span t-if="order.state == 'done'" class="badge bg-success">Done</span>
                                <span t-if="order.state == 'cancel'" class="badge bg-danger">Cancelled</span>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Customer:</strong> <span t-field="order.partner_id.name"/><br/>
                                <strong>Order Date:</strong> <span t-field="order.date_order"/><br/>
                                <strong>Broker Allotment:</strong> <span t-field="order.broker_allotment_id.name"/><br/>
                            </div>
                            <div class="col-6">
                                <t t-if="order.pay_date">
                                    <strong>Pay Date:</strong> <span t-field="order.pay_date"/><br/>
                                </t>
                                <t t-if="order.lift_date">
                                    <strong>Lift Date:</strong> <span t-field="order.lift_date"/><br/>
                                </t>
                                <t t-if="order.tender_id">
                                    <strong>Tender:</strong> <span t-field="order.tender_id.name"/><br/>
                                </t>
                            </div>
                        </div>

                        <table class="table table-sm" t-if="order.order_line">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="order.order_line" t-as="line">
                                    <tr>
                                        <td>
                                            <span t-field="line.name"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.product_uom_qty"/>
                                            <span t-field="line.product_uom_id.name"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end">
                                        <strong>Total:</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong><span t-field="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/></strong>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <t t-if="order.note">
                            <div class="mt-3">
                                <strong>Notes:</strong><br/>
                                <div t-field="order.note"/>
                            </div>
                        </t>
                    </div>
                    <div class="card-footer">
                        <a t-attf-href="/my/broker-allotment/{{ order.broker_allotment_id.id }}" class="btn btn-secondary">
                            <i class="fa fa-arrow-left me-2"/>Back to Broker Allotment
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
