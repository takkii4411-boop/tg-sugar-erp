<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Portal user can only see their own broker allotment records -->
        <record id="broker_allotment_portal_rule" model="ir.rule">
            <field name="name">Broker Allotment: Portal User sees own records only</field>
            <field name="model_id" ref="sale_order_modifier_hmrc.model_broker_allotment"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Portal user can only see lines related to their broker allotments -->
        <record id="broker_allotment_line_portal_rule" model="ir.rule">
            <field name="name">Broker Allotment Line: Portal User sees own lines only</field>
            <field name="model_id" ref="sale_order_modifier_hmrc.model_broker_allotment_line"/>
            <field name="domain_force">[('broker_allotment_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>
        <!-- Portal user can create Sale Orders linked to their broker allotment -->
        <record id="sale_order_portal_rule" model="ir.rule">
            <field name="name">Sale Order: Portal User sees orders linked to their broker allotment</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('broker_allotment_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Portal user can create Sale Order Lines linked to their broker allotment lines -->
        <record id="sale_order_line_portal_rule" model="ir.rule">
            <field name="name">Sale Order Line: Portal User sees lines linked to their broker allotment</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[('order_id.broker_allotment_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>
    </data>

    <!-- Server Action: Create Portal Users for All Brokers -->
    <record id="action_create_portal_users_for_brokers" model="ir.actions.server">
        <field name="name">Create Portal Users for All Brokers</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">
action = env['res.partner'].create_portal_users_for_brokers()
        </field>
    </record>

    <!-- Menu item for the server action -->
    <menuitem id="menu_create_portal_users"
              name="Create Portal Users for Brokers"
              parent="base.menu_administration"
              action="action_create_portal_users_for_brokers"
              sequence="100"/>
</odoo>
