<odoo>
    <record id="view_po_lot_wizard" model="ir.ui.view">
        <field name="name">po.lot.wizard.form</field>
        <field name="model">po.lot.wizard</field>
        <field name="arch" type="xml">
            <form string="PO Lot Report">
                <sheet>
                    <group>
                        <group>
                            <field name="from_date"/>
                        </group>
                        <group>
                            <field name="to_date"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Print PDF" name="action_print_report" type="object" class="btn-primary"/>
                    <button string="Download in Excel" name="action_export_excel" type="object" class="btn-secondary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_po_lot_wizard" model="ir.actions.act_window">
        <field name="name">PO Lot Report</field>
        <field name="res_model">po.lot.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>