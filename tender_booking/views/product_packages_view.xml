<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_product_package_tree" model="ir.ui.view">
            <field name="name">cus.product.package.list</field>
            <field name="model">cus.product.package</field>
            <field name="arch" type="xml">
                <list editable='bottom'>
                    <field name="name" required='1'/>
                    <!-- <field name="quantity_contain"/> -->
                    <field name="per_qt_quantity"/>
                    <field name="is_default"/>
                </list>
            </field>
        </record>
    
        <record model="ir.actions.act_window" id="action_product_package">
            <field name="name">Product Packagings</field>
            <field name="res_model">cus.product.package</field>
            <field name="view_mode">list</field>
             <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click on Create to add a new Product Packagings.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_product_package"
            action="action_product_package"
            name="Product Packagingst" 
            parent="stock.menu_stock_config_settings" 
            sequence="0"/>

    </data>
</odoo>
