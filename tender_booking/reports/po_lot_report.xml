<odoo>
    <template id="po_lot_report_template">
        <t t-call="web.external_layout">
            <main>
                <div class="page">
                    <h3 class="text-center"><strong><b>PO Lot Report</b></strong></h3>
                    <p style="text-align:center; margin-top:0; margin-bottom:10px;"
                       t-if="env.context.get('date_from') or env.context.get('date_to')">

                        <t t-if="env.context.get('date_from')">
                            <t t-esc="env.context.get('date_from')"/>
                        </t>

                        <t t-if="env.context.get('date_from') and env.context.get('date_to')">
                            To
                        </t>

                        <t t-if="env.context.get('date_to')">
                            <t t-esc="env.context.get('date_to')"/>
                        </t>

                    </p>

                   
                    <t t-foreach="env.context.get('rows', [])" t-as="row">
                        <table class="table table-bordered" style="margin-top:12px;">
                            <tr>
                                <th><strong><b>PO No</b></strong></th>
                                <th><strong><b>Date</b></strong></th>
                                <th><strong><b>Party Name</b></strong></th>
                                <th><strong><b>P Rate</b></strong></th>
                                <th><strong><b>Tender QTY</b></strong></th>
                            </tr>
                            <tr>
                                <td><t t-esc="row['tender_no']"/></td>
                                <td><t t-esc="row['booking_date']"/></td>
                                <td><t t-esc="row['partner_name']"/></td>
                                <td><t t-esc="row['rate']"/></td>
                                <td><t t-esc="row['ordered_qty']"/></td>
                            </tr>
                        </table>

                        <table class="table table-sm table-bordered" style="margin-bottom:25px;">
                            <thead>
                                <tr style="background-color:#f0f0f0; text-align:center;">
                                    <th><strong><b>Inv No</b></strong></th>
                                    <th><strong><b>Date</b></strong></th>
                                    <th><strong><b>Particulars</b></strong></th>
                                    <th><strong><b>Broker</b></strong></th>
                                    <th><strong><b>Lorry No</b></strong></th>
                                    <th><strong><b>SO Rate</b></strong></th>
                                    <th><strong><b>Qty</b></strong></th>
                                    <th><strong><b>Diff</b></strong></th>
                                    <th><strong><b>D Amt</b></strong></th>
                                    <th><strong><b>Cr Days</b></strong></th>
                                    <th><strong><b>Int</b></strong></th>
                                    <th><strong><b>NGp</b></strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="row.get('deliveries')">
                                    <t t-set="total_qty" t-value="0.0"/>
                                    <t t-set="total_d_amt" t-value="0.0"/>

                                    <t t-foreach="row['deliveries']" t-as="del">
                                        <tr>
                                            <td><t t-esc="del.get('vch_no', '')"/></td>
                                            <td><t t-esc="del.get('date', '')"/></td>
                                            <td><t t-esc="del.get('particulars', '')"/></td>
                                            <td><t t-esc="del.get('broker', '')"/></td>
                                            <td><t t-esc="del.get('lorry_no', '')"/></td>
                                            <td><t t-esc="del.get('so_rate', 0.0)"/></td>
                                            <td><t t-esc="del.get('qty', 0.0)"/></td>
                                            <td><t t-esc="del.get('diff', 0.0)"/></td>
                                            <td><t t-esc="del.get('d_amt', 0.0)"/></td>
                                            <td><t t-esc="del.get('cr_days', '')"/></td>
                                            <td><t t-esc="del.get('int', '')"/></td>
                                            <td><t t-esc="del.get('ngp', '')"/></td>
                                        </tr>
                                        <t t-set="total_qty" t-value="total_qty + (del.get('qty') or 0)"/>
                                        <t t-set="total_d_amt" t-value="total_d_amt + (del.get('d_amt') or 0)"/>
                                    </t>
                                    <tr style="background-color:#f0f0f0; font-weight:bold; text-align:center;">
                                        <td colspan="4" style="border:1px solid #000; padding:4px;">
                                            Total
                                        </td>
                                        <td style="border:1px solid #000; padding:4px;"></td>
                                        <td style="border:1px solid #000; padding:4px;"></td>
                                        <td style="border:1px solid #000; padding:4px;"><t t-esc="total_qty"/></td>
                                        <td style="border:1px solid #000; padding:4px;"></td>
                                        <td style="border:1px solid #000; padding:4px;"><t t-esc="total_d_amt"/></td>
                                        <td style="border:1px solid #000; padding:4px;"></td>
                                        <td style="border:1px solid #000; padding:4px;"></td>
                                        <td style="border:1px solid #000; padding:4px;"></td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="12" style="text-align:center;">
                                            No Delivery Found
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            
                        </table>
                    </t>
                </div>
            </main>
        </t>
    </template>
    <record id="po_lot_report_pdf" model="ir.actions.report">
        <field name="name">PO Lot Report</field>
        <field name="model">po.lot.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tender_booking.po_lot_report_template</field>
        <field name="report_file">tender_booking.po_lot_report_template</field>
    </record>
</odoo>
