<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_tender_booking" model="ir.sequence">
            <field name="name">Tender Booking Sequence</field>
            <field name="code">tender.booking</field>
            <field name="prefix">TG/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="implementation">standard</field>
        </record>
        <record id="seq_vendor_lot_no" model="ir.sequence">
            <field name="name">Vendor Lot Sequence</field>
            <field name="code">vendor.lot.seq</field>
            <field name="padding">3</field>
            <field name="prefix"></field>
        </record>
    </data>
</odoo>