<odoo>
    <data>
       <template id="report_office_pdf">
            <t t-call="web.html_container">     
                <t t-call="party_sale_modifier_hmrc.external_layout_boxed_custom_office">
                    <main>
                        <style>
                            table { width: 100%; border-collapse: collapse; font-size: 12px; }
                            td, th { border: 1px solid black; padding: 4px; vertical-align: top; }
                            .no-border td { border: none; }
                            .center { text-align: center; }
                            .right { text-align: right; }
                            .bold { font-weight: bold; }
                            .big { font-size: 16px; }
                            .red { color: red; }
                        </style> 
                        <table>
                            <tr>
                                <td class="center bold big">OFFICE COPY</td>
                            </tr>
                        </table>
                    
                        <table>
                            <tr>
                                <td width="50%">
                                    <b>Bill To</b><br/>
                                    <span class="bold"><b>Party Name :</b></span>
                                    <b><t t-esc="docs[0].partner_id.name"/></b><br/>
                                    <span class="bold"><b>Address Full :</b></span>
                                    <t t-esc="docs[0].partner_id.street"/>
                                    <t t-esc="docs[0].partner_id.street2"/><br/>
                                    <t t-esc="docs[0].partner_id.city"/>
                                    <t t-esc="docs[0].partner_id.zip"/><br/>
                                    <t t-esc="docs[0].partner_id.state_id.name"/>
                                    <t t-esc="docs[0].partner_id.country_id.name"/><br/>
                                    <span class="bold"><b>GSTIN :</b></span>
                                    <t t-esc="docs[0].partner_id.vat"/><br/>
                                    <span class="bold"><b>PAN No :</b></span>
                                    <t t-esc="docs[0].partner_id.l10n_in_pan_entity_id.name or ''"/><br/>
                                    <span class="bold"><b>Fssai No :</b></span>
                                    <t t-esc="docs[0].partner_id.fassi_no"/><br/>
                                    <span class="bold"><b>Mob No :</b></span>
                                    <t t-esc="docs[0].partner_id.phone"/>
                                    <span style="margin-left:5px;" class="bold"><b>E-Mail :</b></span><t t-esc="docs[0].partner_id.email"/>
                                </td>
                                <td width="50%">
                                    <b>Ship To</b><br/>
                                    <span class="bold"><b>Party Name : </b></span>
                                    <b><t t-esc="docs[0].partner_id.name"/></b><br/>
                                    <span class="bold"><b>Address Full : </b></span>
                                    <t t-esc="docs[0].partner_id.street"/>
                                    <t t-esc="docs[0].partner_id.street2"/><br/>
                                    <t t-esc="docs[0].partner_id.city"/>
                                    <t t-esc="docs[0].partner_id.zip"/><br/>
                                    <t t-esc="docs[0].partner_id.state_id.name"/><br/>
                                    <span class="bold"><b>GSTIN : </b></span>
                                    <t t-esc="docs[0].partner_id.vat"/><br/>
                                    <span class="bold"><b>PAN No : </b></span>
                                    <t t-esc="docs[0].partner_id.l10n_in_pan_entity_id.name or ''"/><br/>
                                    <span class="bold"><b>Fssai No : </b></span>
                                    <t t-esc="docs[0].partner_id.fassi_no"/><br/>
                                    <span class="bold"><b>Mob No : </b></span>
                                    <t t-esc="docs[0].partner_id.phone"/>
                                    <span style="margin-left:5px;" class="bold"><b>E-Mail : </b></span><t t-esc="docs[0].partner_id.email"/>
                                </td>
                            </tr>
                        </table>
                        <table>
                            <tr class="bold center">
                                <td>Description of Goods</td>
                                <td>HSN NO.</td>
                                <td>QTY-QTL</td>
                                <td>TYPE</td>
                                <td>S Rate</td>
                                <!-- <td>Inc. GST</td> -->
                                <td>Amount</td>
                            </tr>

                            <t t-foreach="docs[0].move_ids" t-as="line">
                                <tr>
                                    <td>
                                        <b class="big center">
                                            <t t-esc="line.product_id.name"/>
                                        </b>
                                    </td>
                                    <td class="center">
                                        <t t-esc="line.product_id.l10n_in_hsn_code"/>
                                    </td>
                                    <td class="center">
                                        <t t-esc="int(line.sale_line_id.qty_delivered)"/>
                                        <br/>
                                        <t t-set="po_line" t-value="docs[0].env['purchase.order.line'].search([
                                            ('order_id', '=', docs[0].sale_id.broker_allotment_id.tender_id.id),
                                            ('product_id', '=', line.product_id.id)
                                        ], limit=1)"/>

                                        <t t-if="po_line and po_line.cus_packing_id">

                                            <t t-set="pack_name" t-value="po_line.cus_packing_id.name"/>

                                            <t t-set="per_qt" t-value="po_line.cus_packing_id.per_qt_quantity or 0"/>

                                            <t t-set="total_qty_kg" t-value="line.sale_line_id.qty_delivered"/>

                                            <t t-set="total_qty_qt" t-value="total_qty_kg / 100"/>

                                            <t t-if="per_qt and total_qty_qt">
                                                <t t-set="bags" t-value="total_qty_qt*100 / per_qt"/>
                                                <span style="font-size:10px;">
                                                    <t t-esc="int(bags)"/> <t t-esc="pack_name"/>
                                                </span>
                                            </t>

                                            <t t-if="not per_qt">
                                                <span style="font-size:10px;">
                                                    <t t-esc="int(total_qty_kg)"/> <t t-esc="pack_name"/>
                                                </span>
                                            </t>
                                        </t>
                                    </td>
                                    <td class="center"><t t-esc="docs[0].sale_id.rate_type"/></td>
                                    <td class="center"><t t-esc="line.sale_line_id.price_unit"/></td>
                                    <!-- <td class="center"><t t-esc="line.sale_line_id.tax_ids.name"/></td> -->
                                    <td class="center"><t t-esc="line.sale_line_id.price_subtotal"/></td>    
                                </tr>
                            </t>
                        </table>
                        <table>
                            <tr>
                                <td colspan="3" style="border:1px solid #000; font-size:16px;">
                                    <span class="bold"><b>Credit Days : </b></span>
                                     <t t-esc="docs[0].sale_id.order_line[0].delay_days"/> Days<br/>
                                    <span style="margin-left:250px; text-align:right;" class="bold"><b>Rate Diff. : </b></span>
                                    <t t-esc="(docs[0].move_ids.sale_line_id.price_unit or 0.0) - (docs[0].sale_id.broker_allotment_id.tender_id.order_line.price_unit or 0.0)"/><br/>
                                    <t t-set="aging" t-value="docs[0].get_partner_aging()"/>

                                    <span class="bold"><b>Party Outstanding Balance :</b></span><br/>

                                    0-30 Days :
                                    ₹ <t t-esc="round(aging['0_30'], 2)"/><br/>

                                    31-60 Days :
                                    ₹ <t t-esc="round(aging['31_60'], 2)"/><br/>

                                    61-90 Days :
                                    ₹ <t t-esc="round(aging['61_90'], 2)"/><br/>

                                    90+ Days :
                                    ₹ <t t-esc="round(aging['90_plus'], 2)"/><br/>
                                    <t t-set="total" t-value="aging['0_30'] + aging['31_60'] + aging['61_90'] + aging['90_plus']"/>
                                    <b>Total :</b>
                                    ₹ <t t-esc="round(total, 2)"/>
                                </td>
                            
                                <td colspan="3" style="border:1px solid #000; padding:0;">
                                    <table style="width:100%; border-collapse:collapse;">
                                        <tr>
                                            <td colspan="2" style="border:1px solid #000; font-weight:bold;">
                                                <b>Sub Total</b>
                                            </td>
                                            <td style="border:1px solid #000; font-weight:bold;"><t t-esc="docs[0].sale_id.amount_untaxed"/></td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" style="border:1px solid #000; font-weight:bold;">
                                                <b>C-GST</b>
                                            </td>
                                            <td style="border:1px solid #000; font-weight:bold;">
                                                <t t-esc="
                                                 sum(
                                                   tg['tax_amount']
                                                   for st in docs[0].sale_id.tax_totals['subtotals']
                                                   for tg in st['tax_groups']
                                                   if tg['group_name'] == 'CGST'
                                                 )
                                                "/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" style="border:1px solid #000; font-weight:bold;">
                                                <b>S-GST</b>
                                            </td>
                                            <td style="border:1px solid #000; font-weight:bold;">
                                                <t t-esc="
                                                 sum(
                                                   tg['tax_amount']
                                                   for st in docs[0].sale_id.tax_totals['subtotals']
                                                   for tg in st['tax_groups']
                                                   if tg['group_name'] == 'SGST/UTGST'
                                                 )
                                                "/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" style="border:1px solid #000; font-weight:bold;">
                                                <b>I-GST</b>
                                            </td>
                                            <td style="border:1px solid #000; font-weight:bold;">
                                                <t t-esc="
                                                 sum(
                                                   tg['tax_amount']
                                                   for st in docs[0].sale_id.tax_totals['subtotals']
                                                   for tg in st['tax_groups']
                                                   if tg['group_name'] == 'IGST'
                                                 )
                                                "/>
                                            </td>
                                        </tr>
                                        
                                        <tr>
                                            <td colspan="2" style="border:1px solid #000; font-weight:bold;">
                                                <b>Net Amount</b>
                                            </td>
                                            <td style="border:1px solid #000; font-weight:bold;"><t t-esc="docs[0].sale_id.amount_total"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="4" style="border-bottom:1px solid #000; text-align:center; font-weight:bold;">
                                    <b>DELIVERY INTIMATION</b>
                                </td>
                            </tr>

                            <tr>
                                <td style="border-right:1px solid #000;">
                                    <b>DO No. : </b><t t-esc="docs[0].name"/><br/>
                                </td>
                                <td style="border-right:1px solid #000;">
                                    <b>Mail ID: </b><t t-esc="docs[0].partner_id.email"/><br/>
                                </td>
                                <td style="border-right:1px solid #000;">
                                    <b>Time : </b>
                                    <t t-esc="docs[0].scheduled_date" t-options="{'widget': 'datetime', 'format': 'HH:mm'}"/><br/>
                                </td>
                                <td>
                                    <b>DO Date :  </b>
                                    <t t-esc="docs[0].scheduled_date" t-options="{'widget': 'date', 'format': 'dd-MM-yyyy'}"/><br/>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="2" style="border-right:1px solid #000;">
                                    <b>Dispatch From : </b>
                                    <t t-set="po" t-value="docs[0].sale_id.broker_allotment_id.tender_id"/>
                                        <t t-if="po.partner_id.name != po.dispatch_location_id.name">
                                            <t t-esc="po.partner_id.name"/>
                                            (<t t-esc="po.dispatch_location_id.complete_name"/>)
                                        </t>

                                        <t t-else="">
                                            <t t-esc="po.dispatch_location_id.complete_name"/>
                                        </t><br/>            
                                </td>
                                <td colspan="2">
                                    <b>QTY : </b><t t-esc="docs[0].sale_id.broker_allotment_id.tender_id.order_line.product_qty"/><br/>
                                </td> 
                            </tr>

                            <tr>
                                <td style="border-right:1px solid #000;">
                                    <b>Lorry No. :  </b><t t-esc="docs[0].vehicle_number"/><br/>
                                </td>
                                <td style="border-right:1px solid #000;">
                                    <b>Transport : </b><t t-esc="docs[0].transport_name.name"/><br/>
                                </td>
                                <td style="border-right:1px solid #000;">
                                    <b>Driver : </b><t t-esc="docs[0].driver_id.name"/><br/>
                                </td>
                                <td>
                                    <b>D. Mob : </b><t t-esc="docs[0].driver_phone"/><br/>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="2" style="border-right:1px solid #000;">
                                    <b>Through : </b><t t-esc="docs[0].sale_id.broker_allotment_id.partner_id.name"/><br/> 
                                </td>
                                <td style="border-right:1px solid #000;">
                                    <b>PSO No. : </b><t t-esc="docs[0].sale_id.name"/><br/>
                                </td>
                                <td>
                                    <b>PSO Date : </b><t t-esc="docs[0].sale_id.date_order"/><br/>
                                </td>
                            </tr>

                            <tr>
                                <td style="border-right:1px solid #000;">
                                    <b>Freight : </b>
                                        <t t-set="moves"
                                           t-value="env['account.move'].search([
                                                ('picking_id', '=', docs[0].id),
                                                ('state', '=', 'posted'),
                                                ('ref', 'ilike', 'Freight')
                                           ])"/>

                                        <t t-set="freight"
                                           t-value="sum(moves.mapped('amount_total'))"/>

                                        <t t-esc="freight"/>
                                </td>
                                <td style="border-right:1px solid #000;">
                                    <b>Advance : </b>
                                    <t t-set="advance" t-value="0"/>
                                    <t t-esc="advance"/>
                                </td>

                                <td colspan="2">
                                    <b>To Pay : </b>
                                        <t t-set="to_pay" t-value="freight - advance"/>
                                        <t t-esc="to_pay"/>
                                    <br/>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="4" style="border-bottom:1px solid #000; text-align:center; font-weight:bold;">
                                    <b>PO Details</b>
                                </td>
                            </tr>
                            <tr>
                                <td style="border-right:1px solid #000;">
                                    <b>PO No. : </b><t t-esc="docs[0].sale_id.broker_allotment_id.tender_id.name"/><br/>
                                </td>
                                <td style="border-right:1px solid #000;">
                                    <b>Contract No. : </b><t t-esc="docs[0].sale_id.broker_allotment_id.tender_id.contract_no"/><br/>
                                </td>
                                <td colspan="2">
                                    <b>Date : </b><t t-esc="docs[0].sale_id.broker_allotment_id.tender_id.booking_date"/><br/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border-right:1px solid #000;">
                                    <b>PO Rate : </b><t t-esc="docs[0].sale_id.broker_allotment_id.tender_id.order_line.price_unit"/><br/>
                                </td>
                                <td style="border-right:1px solid #000;">
                                    <b>PO Amount : </b><t t-esc="docs[0].sale_id.broker_allotment_id.tender_id.order_line.price_subtotal"/><br/>
                                </td>
                                <td colspan="2">
                                    <b>Vendor A/C Bal : </b>
                                    <t t-set="vendor_bal" t-value="docs[0].get_vendor_balance()"/>
                                    ₹ <t t-esc="'{:,.2f}'.format(vendor_bal)"/> <br/>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="3" style="border-top:1px solid #000;">
                                    <b>Remark : </b><t t-esc="docs[0].note"/><br/>
                                </td>
                                <td style="text-align:center;">
                                    <strong>TG Sugars Ltd</strong><br/><br/>
                                    Prepared by
                                </td>
                            </tr>
                        </table>
                    </main>
                </t>
            </t>
        </template>
        
        <record id="action_report_office" model="ir.actions.report">
            <field name="name">Print Office Copy</field>
            <field name="model">stock.picking</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">party_sale_modifier_hmrc.report_office_pdf</field>
            <field name="report_file">party_sale_modifier_hmrc.report_office_pdf</field>
            <field name="print_report_name">'Office Copy - %s' % (object.name)</field>
        </record>

    </data>
</odoo>
