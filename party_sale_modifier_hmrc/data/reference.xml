<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_party_sale_order" model="ir.sequence">
            <field name="name">Party Sale Reference</field>
            <field name="code">party.sale.order</field>
            <field name="prefix">PSO/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>
        <record id="product_freight_charge" model="product.template">
            <field name="name">Freight Charge</field>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
        </record>
        <record id="product_overdue_credit_charge" model="product.product">
            <field name="name">Credit Delay Charge</field>
            <field name="type">service</field>
            <field name="sale_ok">False</field>
            <field name="purchase_ok">False</field>
        </record>

    </data>
</odoo>
