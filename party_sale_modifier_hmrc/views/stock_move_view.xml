<odoo>
    <record id="view_stock_move_tree_inherit_price" model="ir.ui.view">
        <field name="name">stock.move.tree.inherit.price</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='picked']" position="after">
                <field name="price_unit"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_tree_inherit_sale_order" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.sale.order</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">

            <xpath expr="//list/field[@name='partner_id']" position="after">
                <field name="total_qty"/>
                <field name="unit_rate"/>
                <field name="vehicle_number"/>
            </xpath>

            <xpath expr="//list/field[@name='total_qty']" position="attributes">
                <attribute name="widget">integer</attribute>
                <!-- <attribute name="digits">(16, 0)</attribute> -->
            </xpath>

        </field>
    </record>

</odoo>
