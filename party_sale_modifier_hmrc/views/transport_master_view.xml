<odoo>

    <record id="view_transport_master_tree" model="ir.ui.view">
        <field name="name">transport.master.tree</field>
        <field name="model">transport.master</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_transport_master_form" model="ir.ui.view">
        <field name="name">transport.master.form</field>
        <field name="model">transport.master</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Enter Transport Name"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_transport_master" model="ir.actions.act_window">
        <field name="name">Transport Master</field>
        <field name="res_model">transport.master</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
